import math
import rclpy
from rclpy.node import Node 
from sensor_msgs.msg import LaserScan
import random

class fakelidar(Node):

    def __init__(self):
        super().__init__('fake_lidar')
        self.publisher_= self.create_publisher(LaserScan,'scan',10)
        self.timer = self.create_timer(0.1,self.publish_laser_scan) #hmmmm

        self.num_readings = 360
        self.laser_frequency = 10.0

        self.get_logger().info('Lidar is running...')

    def publish_laser_scan(self):
        msg = LaserScan()

        msg.header.stamp = self.get_clock().now().to_msg()
        msg.header.frame_id = 'laser_frame'

        msg.angle_min = 0.0 
        msg.angle_max = 2*math.pi
        msg.angle_increment = (msg.angle_max-msg.angle_min)/ self.num_readings # why use 2*math.py not msg.angle_max, why change to msg.angle_max-msg.angle_min
        msg.time_increment = (1.0/ self.laser_frequency)/ self.num_readings #
        msg.scan_time = 1.0 / self.laser_frequency
        msg.range_min =0.1
        msg.range_max = 10.0
        far_distance = 10.0 #no obsticals
        ranges = [far_distance]*self.num_readings #ezay badrab distance fe zawya as a list

        for i in range(self.num_readings):

            if 90 <= i <= 135:
                ranges[i] = 2.0
            elif 250<= i <= 295
                ranges[4.0]

        msg.ranges = ranges
        for i in range(self.num_readings):
            distance = 3.0 +random.uniform(-0.02,0.02)#
            msg.ranges.append(distance)
        self.publisher_.publish(msg)

def main(args=None): 
    rclpy.init(args=args)
    node = fakelidar()
    try: #try bete3mel eh
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass #zay break
    finally: #bete3mel eh
        node.destroy_node()
        rclpy.shutdown()
if __name__ == '__main__':
    main()